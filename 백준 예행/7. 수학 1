#include <stdio.h>
#include <string.h>
#include <math.h>

int main() {
    char N[36];
    int B;
    scanf("%s %d", N, &B);

    int len = strlen(N);
    long long result = 0;
    long long power = 1;

    for (int i = len - 1; i >= 0; i--) {
        int digit;
        if (N[i] >= '0' && N[i] <= '9') {
            digit = N[i] - '0';
        }
        else {
            digit = N[i] - 'A' + 10;
        }
        result += digit * power;
        power *= B;
    }

    printf("%lld\n", result);
    return 0;
}

