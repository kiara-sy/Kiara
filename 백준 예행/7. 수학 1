#include <stdio.h>

int main() {
    long long N;
    scanf("%lld", &N);

    long long layer = 1; 
    long long maxNum = 1;

    while (N > maxNum) {
        maxNum += 6 * layer;
        layer++;
    }

    printf("%lld\n", layer);
    return 0;
}

