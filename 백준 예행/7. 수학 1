#include <stdio.h>

int main() {
    int X;
    scanf("%d", &X);

    int n = 1;
    while (X > n * (n + 1) / 2) {
        n++;
    }
    int start = n * (n - 1) / 2 + 1;
    int offset = X - start;

    int numerator, denominator;

    if (n % 2 == 0) {
        numerator = 1 + offset;
        denominator = n - offset;
    }
    else {  
        numerator = n - offset;
        denominator = 1 + offset;
    }
    printf("%d/%d\n", numerator, denominator);
    return 0;
}

