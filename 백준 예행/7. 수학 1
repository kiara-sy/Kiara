#include <stdio.h>

int main() {
    long long N;
    int B;
    char result[100];
    int idx = 0;
    scanf("%lld %d", &N, &B);

    while (N > 0) {
        int digit = N % B;
        if (digit < 10) {
            result[idx++] = '0' + digit;
        }
        else {
            result[idx++] = 'A' + (digit - 10);
        }
        N /= B;
    }

    for (int i = idx - 1; i >= 0; i--) {
        printf("%c", result[i]);
    }
    printf("\n");

    return 0;
}

